# Copy to .env.local (git-ignored) to build the owner's app, which opens without a sign-in.
# Expo inlines these at bundle time; build with a cleared cache after changing them.
# EXPO_PUBLIC_API_KEY must equal MOBILE_API_KEY on the server (Render). Generate one with e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(36))"
EXPO_PUBLIC_SERVER_URL=https://pc-mania.onrender.com
EXPO_PUBLIC_API_KEY=
